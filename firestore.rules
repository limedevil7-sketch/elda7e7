rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function validAdminMaintenanceData() {
      return request.resource.data.keys().hasOnly(['enabled', 'message', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 160
        && request.resource.data.updatedBy == 'lime_devil'
        && request.resource.data.updatedAt is timestamp;
    }

    match /questions/{questionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'author', 'authorUid', 'time',
          'answer', 'answerBy', 'answerAt', 'admin'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 1000
        && request.resource.data.category is string
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 80
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.time is int
        && request.resource.data.answer == ''
        && request.resource.data.answerBy == ''
        && request.resource.data.answerAt == 0
        && request.resource.data.admin == false;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'answerBy', 'answerAt'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 1000
        && request.resource.data.answerBy == 'lime_devil'
        && request.resource.data.answerAt is int;

      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /sitePresence/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'page', 'lastSeen'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 80
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 160
        && request.resource.data.lastSeen is timestamp;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'maintenance';
      allow create: if settingId == 'maintenance'
        && isAdmin()
        && validAdminMaintenanceData();
      allow update: if settingId == 'maintenance'
        && (
          (isAdmin() && validAdminMaintenanceData())
          || (
            signedIn()
            && resource.data.enabled == true
            && request.resource.data.enabled == false
            && request.resource.data.keys().hasOnly(['enabled', 'message', 'updatedBy', 'updatedAt'])
            && request.resource.data.message is string
            && request.resource.data.message.size() <= 160
            && request.resource.data.updatedBy == 'recovery'
            && request.resource.data.updatedAt is timestamp
            && exists(/databases/$(database)/documents/maintenanceRecovery/$(request.auth.uid))
            && get(/databases/$(database)/documents/maintenanceRecovery/$(request.auth.uid)).data.code == 'SOS'
          )
        );
      allow delete: if false;
    }

    match /maintenanceRecovery/{uid} {
      allow read: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/siteSettings/maintenance).data.enabled == true
        && request.resource.data.keys().hasOnly(['code', 'createdAt'])
        && request.resource.data.code == 'SOS'
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /activityLogs/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'actor', 'action', 'target', 'details', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.actor is string
        && request.resource.data.actor.size() <= 80
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 50
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 160
        && request.resource.data.details is map
        && request.resource.data.details.size() <= 5
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}